---
import type { Course } from "../lib/courses";
import { coursePath, slugOf } from "../lib/courses";
import { toFa } from "../lib/site";

interface Props {
  course: Course;
  index: number;
}

const { course, index } = Astro.props;
const { data } = course;
const numeral = toFa(String(index + 1).padStart(2, "0"));
// Search index: title + subject + description + tags, normalized for matching.
const haystack = [data.title, data.subject, data.description, ...data.tags]
  .join(" ")
  .replace(/[\u200C\s]+/g, " ");
---

<article
  data-course-row
  data-subject={data.subject}
  data-haystack={haystack}
  aria-labelledby={`course-${course.id}`}
  class="group grid gap-3 border-t border-line py-6 first:border-t-0 sm:grid-cols-[auto_1fr_auto] sm:items-start sm:gap-6"
>
  <span
    aria-hidden="true"
    class="text-4xl font-black leading-none text-amber/80 tabular-nums sm:text-5xl"
  >
    {numeral}
  </span>
  <div class="min-w-0">
    <p class="text-xs font-bold text-muted">{data.subject}</p>
    <h3
      id={`course-${course.id}`}
      class="mt-1 text-xl font-extrabold leading-snug text-ink"
    >
      <a
        href={coursePath(slugOf(course.id))}
        class="rounded-sm group-hover:text-pine group-hover:underline group-hover:underline-offset-4"
      >
        {data.title}
      </a>
    </h3>
    <p class="prose-fa mt-2 text-[0.95rem] text-muted">{data.description}</p>
    {
      data.tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2" aria-label={`برچسب‌های ${data.title}`}>
          {data.tags.map((tag) => (
            <li class="rounded-full bg-wash px-3 py-1 text-xs font-bold text-muted">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="flex flex-row flex-wrap items-center gap-2 sm:flex-col sm:items-stretch">
    <a
      href={data.website}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-xl bg-pine px-5 py-2.5 text-sm font-extrabold text-white hover:bg-pine-deep"
    >
      ورود به وب‌سایت
      <svg
        aria-hidden="true"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 17 17 7" />
        <path d="M8 7h9v9" />
      </svg>
    </a>
    {
      data.github && (
        <a
          href={data.github}
          target="_blank"
          rel="noopener"
          aria-label={`مخزن گیت‌هاب دوره ${data.title}`}
          class="inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-xl border border-line px-4 py-2.5 text-sm font-bold text-muted hover:border-pine hover:text-pine"
        >
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.21-2.48-.83-3.5.08-.83.04-1.68-.12-2.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.16.82-.2 1.67-.12 2.5-.61 1.02-.91 2.25-.83 3.5 0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          گیت‌هاب
        </a>
      )
    }
  </div>
</article>
