---
import { Image } from "astro:assets";
import type { Course } from "../lib/courses";
import { coursePath, slugOf } from "../lib/courses";

interface Props {
  course: Course;
}

const { course } = Astro.props;
const { data } = course;
---

<article
  aria-labelledby={`featured-${course.id}`}
  class="overflow-hidden rounded-2xl border border-line bg-surface shadow-[0_18px_50px_-30px_rgba(28,25,23,0.45)]"
>
  <div class="grid gap-0 md:grid-cols-2">
    <div class="flex flex-col justify-center gap-5 p-6 sm:p-10">
      <p class="text-sm font-bold text-amber">
        پیشنهاد اول — {data.subject}
      </p>
      <h3
        id={`featured-${course.id}`}
        class="text-2xl font-black leading-snug text-ink sm:text-3xl"
      >
        {data.title}
      </h3>
      <p class="prose-fa text-base text-muted">{data.description}</p>
      {
        data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2" aria-label="برچسب‌ها">
            {data.tags.map((tag) => (
              <li class="rounded-full border border-line bg-paper px-3 py-1 text-xs font-bold text-muted">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href={data.website}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[48px] items-center gap-2 rounded-xl bg-pine px-6 py-3 text-base font-extrabold text-white hover:bg-pine-deep"
        >
          ورود به وب‌سایت دوره
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M7 17 17 7" />
            <path d="M8 7h9v9" />
          </svg>
        </a>
        <a
          href={coursePath(slugOf(course.id))}
          class="link-underline inline-flex min-h-[48px] items-center px-2 text-base font-bold text-pine"
        >
          مشاهده جزئیات
        </a>
      </div>
    </div>
    <div class="relative min-h-56 bg-pine-deep md:min-h-full">
      {
        data.cover ? (
          <Image
            src={data.cover}
            alt={data.coverAlt ?? `جلد دوره ${data.title}`}
            widths={[640, 960]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class="absolute inset-0 h-full w-full object-cover"
          />
        ) : (
          <div
            aria-hidden="true"
            class="absolute inset-0 flex flex-col justify-between p-6 text-white sm:p-8"
          >
            <span class="text-sm font-bold opacity-70" dir="ltr">
              study.danialrashidi.ir
            </span>
            <span class="text-7xl font-black leading-none opacity-90">
              {data.title.charAt(0)}
            </span>
            <span class="text-base font-bold opacity-70">{data.subject}</span>
          </div>
        )
      }
    </div>
  </div>
</article>
