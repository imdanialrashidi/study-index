---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getPublishedCourses, coursePath, slugOf } from "../../lib/courses";
import { CREATOR_NAME, SITE_URL } from "../../lib/site";

export async function getStaticPaths() {
  const courses = await getPublishedCourses();
  return courses.map((course) => ({
    params: { slug: slugOf(course.id) },
    props: { course, all: courses },
  }));
}

const { course, all } = Astro.props;
const { data } = course;
const { Content } = await course.render();
const path = coursePath(slugOf(course.id));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: data.title,
  description: data.description,
  url: new URL(path, SITE_URL).toString(),
  inLanguage: "fa",
  provider: { "@type": "Person", name: CREATOR_NAME },
};
---

<Base
  title={data.title}
  description={data.description}
  path={path}
  jsonLd={jsonLd}
>
  <SiteHeader showFeaturedLink={all.some((c) => c.data.featured)} />
  <main id="main">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
      <nav aria-label="مسیر صفحه">
        <ol class="flex flex-wrap items-center gap-2 text-sm font-medium text-muted">
          <li>
            <a href="/" class="link-underline text-pine">مرکز مطالعه</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/#courses" class="link-underline text-pine"
              >همه دوره‌ها</a
            >
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{data.subject}</li>
        </ol>
      </nav>

      <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_360px]">
        <article>
          <p class="text-sm font-bold text-amber">{data.subject}</p>
          <h1
            class="mt-2 text-3xl font-black leading-[1.5] text-ink sm:text-4xl"
          >
            {data.title}
          </h1>
          <p class="prose-fa mt-4 text-lg text-muted">{data.description}</p>

          {
            data.tags.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2" aria-label="برچسب‌ها">
                {data.tags.map((tag) => (
                  <li class="rounded-full bg-wash px-3 py-1 text-xs font-bold text-muted">
                    {tag}
                  </li>
                ))}
              </ul>
            )
          }

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href={data.website}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-[52px] items-center gap-2 rounded-xl bg-pine px-7 py-3.5 text-base font-extrabold text-white hover:bg-pine-deep"
            >
              ورود به وب‌سایت دوره
              <svg
                aria-hidden="true"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 17 17 7" />
                <path d="M8 7h9v9" />
              </svg>
            </a>
            {
              data.github && (
                <a
                  href={data.github}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex min-h-[52px] items-center gap-2 rounded-xl border border-line px-5 py-3.5 text-base font-bold text-muted hover:border-pine hover:text-pine"
                >
                  مخزن گیت‌هاب
                </a>
              )
            }
          </div>

          <div class="prose-fa mt-10 border-t border-line pt-8 text-ink">
            <Content />
          </div>

          <p class="mt-10">
            <a
              href="/#courses"
              class="link-underline inline-flex min-h-[44px] items-center font-bold text-pine"
            >
              بازگشت به همه دوره‌ها
            </a>
          </p>
        </article>

        <aside class="space-y-6 lg:pt-2">
          {
            data.cover && (
              <figure class="overflow-hidden rounded-2xl border border-line bg-surface">
                <Image
                  src={data.cover}
                  alt={data.coverAlt ?? `جلد دوره ${data.title}`}
                  widths={[480, 720]}
                  sizes="(max-width: 1024px) 100vw, 360px"
                  class="aspect-[16/10] w-full object-cover"
                />
              </figure>
            )
          }
          {
            data.stats && (
              <div class="rounded-2xl border border-line bg-surface p-6">
                <h2 class="text-sm font-bold text-ink">نمای دوره</h2>
                <dl class="mt-4 space-y-4">
                  {data.stats.map((stat) => (
                    <div class="flex items-baseline justify-between gap-4 border-t border-line pt-3 first:border-t-0 first:pt-0">
                      <dt class="text-sm text-muted">{stat.label}</dt>
                      <dd class="text-xl font-black text-pine">{stat.value}</dd>
                    </div>
                  ))}
                </dl>
                <p class="mt-4 text-xs leading-6 text-muted">
                  این عددها فقط موارد تاییدشده وب‌سایت دوره‌اند.
                </p>
              </div>
            )
          }
          <div class="rounded-2xl bg-wash p-6">
            <h2 class="text-sm font-bold text-ink">سازنده</h2>
            <p class="mt-2 text-sm leading-7 text-muted">
              {CREATOR_NAME} — این دوره یکی از وب‌سایت‌های آموزشی مرکز
              مطالعه است.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <SiteFooter />
</Base>
